# Copy this file to .env and fill in real values. Never commit .env.

# --- Groq API keys -------------------------------------------------------
# Add as many free Groq keys as you want (one per free account you sign up
# for at https://console.groq.com/keys — email or Google/GitHub login,
# no phone/card needed). The server picks one at random per chat message.
# If a key hits its rate limit or daily quota (Groq returns a 429), the
# server automatically retries the SAME message on a different key, so the
# conversation's context is never lost and nobody notices the swap.
#
# You only need GROQ_API_KEY_1 if you just have one key — add more numbered
# ones (up to GROQ_API_KEY_20) as you get them. GROQ_API_KEY (no number)
# also works as a single extra key for backwards compatibility.
GROQ_API_KEY_1=your_first_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=

# Optional overrides
# openai/gpt-oss-20b is Groq's current recommended general-purpose model —
# fast, free-tier friendly, and actively supported (Groq has deprecated
# older Llama chat models like llama-3.1-8b-instant). If this ever 404s
# with "model_not_found", Groq has changed their lineup again — check
# https://console.groq.com/docs/models for the current list.
GROQ_MODEL=openai/gpt-oss-20b
SECRET_PHRASE=crimson falcon nine
SESSION_SECRET=some_long_random_string
PORT=3000
