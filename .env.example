# Copy this file to .env and fill in real values. Never commit .env.

# --- General app settings -------------------------------------------------
# Max length (in tokens) of each AI reply. Higher = longer, more detailed
# replies, but burns through free-tier token quotas faster.
MAX_RESPONSE_TOKENS=1024

# Max chat messages a single logged-in user can send per minute. This is
# server-side abuse protection (separate from any AI provider's own rate
# limits) — keeps one person from hammering the endpoint. 15/min is plenty
# for normal conversation pace.
CHAT_RATE_LIMIT_PER_MIN=15

# --- AI provider ----------------------------------------------------------
# groq     (default): cloud, needs at least one Groq API key below.
# longcat: Meituan's LongCat API — also cloud, OpenAI-compatible, needs at
#          least one LongCat API key below. Check longcat.chat/platform for
#          current free-tier/trial terms before relying on it for a big event.
# local:   talks to an LLM running on your own machine (Ollama, LM Studio,
#          llama.cpp server) — fully free, no rate limits, no signup, but
#          needs that server running on the same machine the whole time.
LLM_PROVIDER=groq

# --- Local LLM settings (only used when LLM_PROVIDER=local) --------------
# Ollama default. For LM Studio use http://localhost:1234/v1/chat/completions
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
# Must be a model you've already pulled/loaded, e.g.: ollama pull llama3.2
LOCAL_LLM_MODEL=llama3.2
# Only needed if you've put your own auth in front of the local server —
# Ollama and LM Studio don't require this by default.
LOCAL_LLM_API_KEY=

# --- Groq API keys (only used when LLM_PROVIDER=groq) --------------------
# Add as many free Groq keys as you want (one per free account you sign up
# for at https://console.groq.com/keys — email or Google/GitHub login,
# no phone/card needed). The server picks one at random per chat message.
# If a key hits its rate limit or daily quota (Groq returns a 429), the
# server automatically retries the SAME message on a different key, so the
# conversation's context is never lost and nobody notices the swap.
#
# You only need GROQ_API_KEY_1 if you just have one key — add more numbered
# ones (up to GROQ_API_KEY_20) as you get them. GROQ_API_KEY (no number)
# also works as a single extra key for backwards compatibility.
GROQ_API_KEY_1=your_first_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=

# GROQ_MODELS is a comma-separated fallback list, tried in order. If a
# model 404s (deprecated/renamed — this has already happened twice with
# Groq's Llama models), the app drops it and moves to the next one
# automatically, so one deprecation doesn't take the whole app down.
# Smaller/weaker models generally get more generous free-tier quotas, which
# is why the default list leads with smaller ones.
#
# Do NOT put classifier/safety models here (e.g. anything with
# "prompt-guard", "llama-guard", "safeguard" in the name, or "whisper" —
# that's audio transcription). Those aren't chat models: they only accept
# a single message to classify, not a back-and-forth conversation, and
# will error out. The app filters these out automatically if you
# accidentally add one, but it's simplest to just not include them.
#
# Single-model shorthand: you can also just set GROQ_MODEL=some-model
# instead of a list. Check https://console.groq.com/docs/models for the
# current lineup and quotas if you want to customize this.
GROQ_MODELS=gemma2-9b-it,allam-2-7b-instruct,openai/gpt-oss-20b

# --- LongCat API keys (only used when LLM_PROVIDER=longcat) --------------
# Sign up and create keys at the LongCat API Platform (search "LongCat API
# platform" — the docs live at longcat.chat/platform). Same idea as Groq:
# add one numbered key per account, LONGCAT_API_KEY_1 through _10 (or
# more), and the app rotates across them the same way on rate limits.
LONGCAT_API_KEY_1=your_first_longcat_api_key_here
LONGCAT_API_KEY_2=
LONGCAT_API_KEY_3=

# LONGCAT_MODELS works like GROQ_MODELS — a comma-separated fallback list.
# LongCat-2.0 is currently the documented chat model; check LongCat's docs
# if that ever changes.
LONGCAT_MODELS=LongCat-2.0

SECRET_PHRASE=crimson falcon nine
SESSION_SECRET=some_long_random_string
PORT=3000
